# ============================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
# Никогда не публикуйте файл .env в Git / на GitHub!
# ============================================================

# --- ВКонтакте -------------------------------------------------
# Токен доступа сообщества ВКонтакте.
# Как получить: Управление -> Настройки сообщества -> Работа с API
# -> Ключи доступа -> Создать ключ. Обязательно включите право
# «Сообщения сообщества». Токен начинается с буквы, например: vk1.a.XXXX...
VK_GROUP_TOKEN=
# ID сообщества ВКонтакте (без минуса)
VK_GROUP_ID=your_group_id_here

# --- GigaChat API ------------------------------------------------
# Client ID проекта GigaChat API.
# Где взять: developers.sber.ru -> Studio -> проект GigaChat API ->
# «Генерация ключа авторизации».
GIGACHAT_CLIENT_ID=

# Client Secret (секретный ключ авторизации) проекта GigaChat API.
# Выдаётся там же, где и Client ID.
GIGACHAT_CLIENT_SECRET=

# Версия API GigaChat:
#   GIGACHAT_API_PERS - для физических лиц (freemium, 60 запросов в сутки)
#   GIGACHAT_API_CORP - для ИП и юридических лиц
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat, которая будет отвечать пользователям.
# Доступные: GigaChat-2 (Lite), GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Ultra
GIGACHAT_MODEL=GigaChat-2

# Проверка SSL-сертификатов НУЦ Минцифры.
# true  - проверять (нужны установленные сертификаты Минцифры)
# false - отключить проверку (проще для запуска, см. инструкцию)
GIGACHAT_VERIFY_SSL_CERTS=false
